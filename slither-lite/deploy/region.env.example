# /etc/slither/region.env — settings shared by every arena on this host.

# Must match the region key in web/src/games/snake/servers.ts (us-east, eu-west, ap-southeast).
SLITHER_REGION=us-east

# The origin the website is served from. Browsers on that site may open sockets here.
# Comma-separate several (e.g. a www and a bare domain). No trailing slash.
SLITHER_ALLOWED_ORIGINS=https://play.quantarena.example
